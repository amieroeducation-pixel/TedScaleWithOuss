# Test Environment Variables for E2E Tests
# Copy this file to .env.local and fill in your test credentials

# Supabase Test User (create in Supabase Dashboard > Authentication > Users)
TEST_EMAIL=test@example.com
TEST_PASSWORD=password123

# Instructions:
# 1. Create a test user in your Supabase project
# 2. Copy this file: cp .env.test.example .env.local
# 3. Update TEST_EMAIL and TEST_PASSWORD with your test user credentials
# 4. Run tests: npx playwright test
